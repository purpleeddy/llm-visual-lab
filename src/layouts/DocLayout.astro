---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/site/Sidebar.astro';
import PageToc from '../components/site/PageToc.astro';
import { type Locale } from '../lib/i18n/routing';
import { t } from '../lib/i18n/ui';

interface Props {
  locale: Locale;
  docId: string;
  title: string;
  lead: string;
  eyebrow?: string;
  status: 'complete' | 'partial' | 'planned';
  paperRefs: string[];
  notYet: string[];
  updated: string;
  /** Anchor id → page URL, for ids that used to live on this page and moved to another */
  movedAnchors?: Record<string, string>;
}

const { locale, docId, title, lead, eyebrow, status, paperRefs, notYet, updated, movedAnchors = {} } = Astro.props;

const ui = t(locale);
const statusLabel = ui.status[status];
const statusNote =
  status === 'complete'
    ? ui.status.completeNote
    : status === 'partial'
      ? ui.status.partialNote
      : ui.status.plannedNote;
---

<BaseLayout locale={locale} title={title} description={lead} docId={docId}>
  {/*
    Left is the whole path this wiki means to cover; right is the contents of
    the article being read. On a narrow screen they stack as article, then
    contents, then path.
  */}
  <div class="shell shell--with-toc">
    <Sidebar locale={locale} current={docId} />

    <main class="main" id="main">
      <article class="prose">
        <header class="doc-header">
          {eyebrow ? <p class="doc-header__eyebrow">{eyebrow}</p> : null}
          <h1>{title}</h1>
          <p class="doc-header__lead">{lead}</p>
          <div class={docId === '' ? 'doc-header__meta visually-hidden' : 'doc-header__meta'}>
            <span class={`badge badge--${status}`} title={statusNote}>
              <span class="badge__dot"></span>
              {statusLabel}
            </span>
            {
              paperRefs.length > 0 ? (
                <span class="paper-ref">
                  <span class="visually-hidden">{ui.paperRef.label}: </span>
                  {paperRefs.join(' · ')}
                </span>
              ) : null
            }
            <span class="doc-header__updated">{updated}</span>
          </div>
        </header>

        <slot />

        {
          notYet.length > 0 ? (
            <aside class="note note--scope">
              <p class="note__title">
                {locale === 'ko' ? '이 문서가 아직 다루지 않는 것' : 'Not covered here yet'}
              </p>
              <ul>
                {notYet.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </aside>
          ) : null
        }

      </article>
    </main>

    <PageToc locale={locale} docId={docId} />
  </div>

  <script is:inline define:vars={{ movedAnchors }}>
    (() => {
      const reveal = () => {
        let id;
        try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
        if (!id) return;
        const target = document.getElementById(id);
        // An old link into content that now lives on the lab or paper page.
        if (!target && Object.hasOwn(movedAnchors, id)) {
          location.replace(`${movedAnchors[id]}#${encodeURIComponent(id)}`);
          return;
        }
        if (!target) return;
        for (let node = target; node; node = node.parentElement) {
          if (node instanceof HTMLDetailsElement) node.open = true;
        }
        requestAnimationFrame(() => target.scrollIntoView({ block: 'start', behavior: 'instant' }));
      };
      reveal();
      window.addEventListener('load', reveal, { once: true });
      window.addEventListener('hashchange', reveal);
    })();
  </script>

  {/*
    Scroll position.
    Marks the section being read in the contents on the right and opens that
    section's sub-headings underneath it.
    Without JavaScript, the four native disclosures still expose all twelve units.
  */}
  <script is:inline>
    (() => {
      const nav = document.querySelector('[data-section-nav]');
      if (!nav || !('IntersectionObserver' in window)) return;

      const links = new Map();
      const items = new Map();
      nav.querySelectorAll('[data-section-link]').forEach((a) => {
        links.set(a.dataset.sectionLink, a);
      });
      nav.querySelectorAll('[data-section-item]').forEach((li) => {
        items.set(li.dataset.sectionItem, li);
      });
      const sections = [...document.querySelectorAll('[data-section]')].filter((el) =>
        links.has(el.dataset.section),
      );
      if (sections.length === 0) return;

      /* --------------- Fold each section's sub-headings into the contents */

      // Collect the sub-headings of each section. One pass is enough.
      const subs = new Map();
      for (const el of sections) {
        subs.set(
          el.dataset.section,
          [...el.querySelectorAll('h3[id]')].filter(h => !h.closest('[data-legacy-exercise]')).map((h) => ({ id: h.id, el: h, text: h.textContent.trim() })),
        );
      }

      const stages = [...nav.querySelectorAll('[data-toc-stage]')];
      const currentLabel = nav.closest('#doc-nav')?.querySelector('[data-current-lesson]');
      let openFor = null;
      let openList = null;
      let subLinks = [];
      let currentSub = null;

      const openSubs = (sectionId) => {
        if (openFor === sectionId) return;
        openList?.remove();
        openList = null;
        subLinks = [];
        currentSub = null;
        openFor = sectionId;

        const list = subs.get(sectionId) ?? [];
        const li = items.get(sectionId);
        if (list.length === 0 || !li) return;

        const ul = document.createElement('ul');
        ul.className = 'toc__sublist';
        ul.dataset.tocSublist = sectionId;
        for (const item of list) {
          const row = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'toc__link toc__link--sub';
          a.href = '#' + encodeURIComponent(item.id);
          a.textContent = item.text;
          a.dataset.tocLink = item.id;
          row.append(a);
          ul.append(row);
        }
        const detail = document.createElement('details');
        detail.className = 'toc__details';
        const summary = document.createElement('summary');
        summary.textContent = document.documentElement.lang.startsWith('ko') ? '이 단원의 세부 목차' : 'Subsections of this unit';
        detail.append(summary, ul);
        li.append(detail);
        openList = detail;
        subLinks = list.map((item, i) => ({ ...item, a: ul.children[i].firstElementChild }));
      };

      // The last sub-heading to cross the 96px line from the top is where we are.
      const markSub = () => {
        if (subLinks.length === 0) return;
        let found = null;
        for (const s of subLinks) {
          if (s.el.getClientRects().length === 0) continue;
          if (s.el.getBoundingClientRect().top <= 96) found = s;
          else break;
        }
        const id = found ? found.id : null;
        if (id === currentSub) return;
        for (const s of subLinks) {
          if (s.id === id) s.a.setAttribute('aria-current', 'true');
          else s.a.removeAttribute('aria-current');
        }
        currentSub = id;
      };

      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            markReadingUnit();
            markSub();
          });
        },
        { passive: true },
      );

      /* ------------------------------------- The section being read */

      let current = null;
      const mark = (id) => {
        if (id === current) return;
        if (current) links.get(current)?.removeAttribute('aria-current');
        current = id;
        if (id) links.get(id)?.setAttribute('aria-current', 'true');
        const stage = items.get(id)?.closest('[data-toc-stage]');
        if (stage) stages.forEach(s => { s.open = s === stage; });
        const link = links.get(id);
        if (currentLabel && link) currentLabel.textContent = `${[...links.keys()].indexOf(id) + 1}/${sections.length} · ${link.dataset.shortTitle}`;
        openSubs(id);
        markSub();
      };

      // A section's end can intersect the viewport while the next heading is
      // already at the reading line. Use the latest section crossing that line.
      const markReadingUnit = () => {
        // Do not replace an open stage while the reader is choosing a link.
        // Hash navigation still updates the unit explicitly after a choice.
        if (nav.contains(document.activeElement)) return;
        // The mobile contents sits after the article. Reading its controls must
        // retain the last unit, rather than count every off-screen unit as read.
        if (sections[sections.length - 1].getBoundingClientRect().bottom < 96) return;
        let active = sections[0];
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= 96) active = section;
          else break;
        }
        mark(active.dataset.section);
      };
      const markHashUnit = () => {
        let id;
        try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
        const section = document.getElementById(id)?.closest('[data-section]');
        if (section) mark(section.dataset.section);
        else markReadingUnit();
      };
      const io = new IntersectionObserver(markReadingUnit,
        { rootMargin: '-96px 0px -55% 0px', threshold: 0 });
      sections.forEach(section => io.observe(section));
      window.addEventListener('hashchange', markHashUnit);
      window.addEventListener('load', markHashUnit, { once: true });
      markHashUnit();
    })();
  </script>
</BaseLayout>
