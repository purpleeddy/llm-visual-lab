---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import { docHref, parseEntryId } from '../lib/i18n/routing';
import { SECTIONS, DOC_SECTIONS } from '../lib/nav';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => {
    const { locale, docId } = parseEntryId(entry.id);
    return {
      params: { slug: docId === '' ? locale : `${locale}/${docId}` },
      props: { entry, locale, docId },
    };
  });
}

const { entry, locale, docId } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

/**
 * Old links into the main article must keep working after content moved to the lab or
 * paper page. Every id another document of this language defines, and the main article
 * no longer does, forwards there.
 */
async function anchorIds(doc: typeof entry, sectionIds: string[]) {
  const { headings } = await render(doc);
  const explicit = [...(doc.body ?? '').matchAll(/\bid="([^"{}]+)"/g)].map((m) => m[1]);
  return new Set([...sectionIds, ...headings.map((h) => h.slug), ...explicit]);
}
const movedAnchors: Record<string, string> = {};
if (docId === '') {
  const here = await anchorIds(entry, SECTIONS.map((s) => s.id));
  const companions = (await getCollection('docs')).filter((other) => {
    const parsed = parseEntryId(other.id);
    return parsed.locale === locale && parsed.docId !== '';
  });
  for (const other of companions) {
    const otherId = parseEntryId(other.id).docId;
    for (const id of await anchorIds(other, (DOC_SECTIONS[otherId] ?? []).map((s) => s.id))) {
      if (!here.has(id) && !(id in movedAnchors)) movedAnchors[id] = docHref(locale, otherId);
    }
  }
}
---

<DocLayout
  locale={locale}
  docId={docId}
  title={data.title}
  lead={data.lead}
  eyebrow={data.eyebrow}
  status={data.status}
  paperRefs={data.paperRefs}
  notYet={data.notYet}
  updated={data.updated}
  movedAnchors={movedAnchors}
>
  <Content />
</DocLayout>
