---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import { parseEntryId } from '../lib/i18n/routing';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => {
    const { locale, docId } = parseEntryId(entry.id);
    return {
      params: { slug: docId === '' ? locale : `${locale}/${docId}` },
      props: { entry, locale, docId },
    };
  });
}

const { entry, locale, docId } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
---

<DocLayout
  locale={locale}
  docId={docId}
  title={data.title}
  lead={data.lead}
  eyebrow={data.eyebrow}
  status={data.status}
  paperRefs={data.paperRefs}
  notYet={data.notYet}
  updated={data.updated}
>
  <Content />
</DocLayout>
