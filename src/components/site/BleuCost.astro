---
/**
 * Table 2 of the paper, read as the argument it is making: quality against what
 * it cost to get there.
 *
 * The values come from `src/lib/paper.ts`, transcribed from the PDF. These are
 * the authors' measurements — the only numbers on this site that were not
 * computed here — and the cost axis is their own estimate, not a measurement.
 */
import type { Locale } from '../../lib/i18n/routing';
import { TABLE2 } from '../../lib/paper';

interface Props {
  locale: Locale;
  /** Which language pair to plot */
  pair?: 'enDe' | 'enFr';
}
const { locale, pair = 'enDe' } = Astro.props;
const ko = locale === 'ko';

const points = TABLE2.map((m) => ({
  model: m.model,
  bleu: pair === 'enDe' ? m.bleuEnDe : m.bleuEnFr,
  flops: pair === 'enDe' ? m.flopsEnDe : m.flopsEnFr,
  transformer: m.transformer,
  ensemble: m.ensemble,
})).filter((p): p is typeof p & { bleu: number; flops: number } => p.bleu !== null && p.flops !== null);

const PAD_L = 66;
const PAD_R = 210;
const PAD_T = 44;
const H = 320;
const W = 720;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - 54;

const exps = points.map((p) => Math.log10(p.flops));
const minE = Math.floor(Math.min(...exps));
const maxE = Math.ceil(Math.max(...exps));
const bleus = points.map((p) => p.bleu);
const minB = Math.floor(Math.min(...bleus) - 0.5);
const maxB = Math.ceil(Math.max(...bleus) + 0.5);

const cx = (flops: number) => PAD_L + ((Math.log10(flops) - minE) / (maxE - minE)) * plotW;
const cy = (bleu: number) => PAD_T + plotH - ((bleu - minB) / (maxB - minB)) * plotH;

const best = points.reduce((a, b) => (b.bleu > a.bleu ? b : a));
const cheapest = points.reduce((a, b) => (b.flops < a.flops ? b : a));
const shortName = (m: string) => m.replace(' model', '');

/**
 * Two of the ensemble points sit almost on top of each other, so their labels
 * are nudged apart by hand. The data is Table 2 and does not move, so a small
 * fixed map is honest here and beats a layout solver nobody can check.
 */
const LABEL_NUDGE: Record<string, { dy: number }> = {
  'ConvS2S Ensemble': { dy: -12 },
  'GNMT + RL Ensemble': { dy: 20 },
};

const L = ko
  ? {
      x: '학습에 든 계산량 (FLOPs, 로그)',
      y: 'BLEU',
      pairName: pair === 'enDe' ? '영어 → 독일어' : '영어 → 프랑스어',
      legendT: 'Transformer',
      legendO: '이전 모델',
      note: `가장 높은 점수는 ${shortName(best.model)} 이고, 계산량이 가장 적은 것도 ${shortName(cheapest.model)} 입니다.`,
      title: `${pair === 'enDe' ? '영어 → 독일어' : '영어 → 프랑스어'} 점수와 학습 계산량`,
      desc: `가로축이 학습에 든 계산량이고 로그 눈금입니다. 세로축은 BLEU 점수로, 높을수록 좋습니다. 왼쪽 위로 갈수록 적게 써서 잘한 것입니다. Transformer 의 두 점은 다른 모델들보다 왼쪽에, 그리고 위에 있습니다. 가장 높은 점수는 ${best.model} 의 ${best.bleu} 이고, 계산량이 가장 적은 것은 ${cheapest.model} 입니다. 가로축의 수치는 저자들이 학습 시간과 GPU 수, 그리고 GPU 한 대의 성능 추정치를 곱해서 **추산한** 값입니다.`,
    }
  : {
      x: 'training cost (FLOPs, log)',
      y: 'BLEU',
      pairName: pair === 'enDe' ? 'English → German' : 'English → French',
      legendT: 'Transformer',
      legendO: 'earlier models',
      note: `the highest score is ${shortName(best.model)}, and the cheapest to train is ${shortName(cheapest.model)}.`,
      title: `${pair === 'enDe' ? 'English to German' : 'English to French'}: score against training cost`,
      desc: `Training cost runs along the bottom on a logarithmic scale, and BLEU up the side, where higher is better. Up and to the left means more for less. Both Transformer points sit further left and higher than the earlier models. The highest score is ${best.bleu} from ${best.model}, and the least expensive to train is ${cheapest.model}. The horizontal axis is the authors' own **estimate**: training time multiplied by the number of GPUs and an assumed rate per GPU.`,
    };

const ticks = Array.from({ length: maxE - minE + 1 }, (_, i) => minE + i);
---

<svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-labelledby="bc-t bc-d">
  <title id="bc-t">{L.title}</title>
  <desc id="bc-d">{L.desc}</desc>

  <text class="tmap__title" x="12" y="26">{L.pairName}</text>

  <path class="tmap__line tmap__line--faint" d={`M ${PAD_L} ${PAD_T} V ${PAD_T + plotH} H ${PAD_L + plotW}`}></path>
  <text class="tmap__note" x="12" y={PAD_T - 6}>{L.y}</text>
  <text class="tmap__note" x={PAD_L + plotW} y={PAD_T + plotH + 38} text-anchor="end">{L.x}</text>

  {
    ticks.map((e) => (
      <g>
        <path class="tmap__line tmap__line--faint" d={`M ${cx(Math.pow(10, e))} ${PAD_T} V ${PAD_T + plotH}`} />
        <text class="tmap__note" x={cx(Math.pow(10, e))} y={PAD_T + plotH + 18} text-anchor="middle">
          10^{e}
        </text>
      </g>
    ))
  }
  {
    Array.from({ length: Math.floor((maxB - minB) / 2) + 1 }, (_, i) => minB + i * 2).map((v) => (
      <text class="tmap__note" x={PAD_L - 10} y={cy(v) + 4} text-anchor="end">
        {v}
      </text>
    ))
  }

  {
    points.map((p) => (
      <g>
        <circle
          class={`bc__dot ${p.transformer ? 'bc__dot--transformer' : ''}`}
          cx={cx(p.flops)}
          cy={cy(p.bleu)}
          r={p.transformer ? 6 : 4.5}
        />
        <text class="tmap__note" x={cx(p.flops) + 10} y={cy(p.bleu) + (LABEL_NUDGE[p.model]?.dy ?? 4)}>
          {shortName(p.model)}
        </text>
      </g>
    ))
  }

  <g>
    <circle class="bc__dot bc__dot--transformer" cx={PAD_L + plotW + 26} cy={PAD_T + 6} r="6" />
    <text class="tmap__note" x={PAD_L + plotW + 40} y={PAD_T + 10}>{L.legendT}</text>
    <circle class="bc__dot" cx={PAD_L + plotW + 26} cy={PAD_T + 28} r="4.5" />
    <text class="tmap__note" x={PAD_L + plotW + 40} y={PAD_T + 32}>{L.legendO}</text>
  </g>

  <text class="tmap__note" x={PAD_L} y={H - 10}>{L.note}</text>
</svg>
