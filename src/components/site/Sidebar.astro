---
/**
 * The left-hand menu — the learning path.
 *
 * Not the **contents of the article** but the route this wiki is taking, starting
 * from one paper and widening into what came after it. Only documents that exist
 * appear, as links. A group with nothing in it yet says so beside its heading.
 *
 * The contents of the article live on the right, in PageToc.
 */
import { COURSE } from '../../lib/curriculum';
import { docHref, type Locale } from '../../lib/i18n/routing';
import { t } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
  /** The document being read */
  current: string;
}

const { locale, current } = Astro.props;
const ui = t(locale);
---

<nav class="sidebar" id="course-nav" aria-label={ui.nav.course}>
  {
    COURSE.map((group) => (
      <div class="sidebar__group">
        <p class="sidebar__title">
          {group.title[locale]}
          {/* A real space, so the heading and the chip are not read as one word */}
          {group.items.length === 0 ? (
            <>
              {' '}
              <span class="sidebar__flag">{ui.nav.inPreparation}</span>
            </>
          ) : null}
        </p>
        {group.items.length > 0 ? (
          <ul class="sidebar__list">
            {group.items.map((item) => (
              <li>
                <a
                  class="sidebar__link"
                  href={docHref(locale, item.id)}
                  aria-current={item.id === current ? 'page' : undefined}>
                  {item.title[locale]}
                </a>
              </li>
            ))}
          </ul>
        ) : null}
      </div>
    ))
  }
</nav>
