---
/**
 * The left-hand menu — the whole learning path.
 *
 * Not the **contents of the article** but the **whole route** this wiki means
 * to cover, starting from one paper and widening into what came after it.
 * Only one entry can be read today; the rest are announcements, not links.
 *
 * The contents of the article live on the right, in PageToc.
 */
import { COURSE } from '../../lib/curriculum';
import { docHref, type Locale } from '../../lib/i18n/routing';
import { t } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
  /** The document being read */
  current: string;
}

const { locale, current } = Astro.props;
const ui = t(locale);
---

<nav class="sidebar" id="course-nav" aria-label={ui.nav.course}>
  {
    COURSE.map((group) => (
      <div class="sidebar__group">
        <p class="sidebar__title">
          {group.title[locale]}
          {group.planned ? <span class="sidebar__flag">{ui.nav.later}</span> : null}
        </p>
        <ul class="sidebar__list">
          {group.items.map((item) =>
            item.status === 'ready' ? (
              <li>
                <a
                  class="sidebar__link"
                  href={docHref(locale, item.id ?? '')}
                  aria-current={item.id === current ? 'page' : undefined}>
                  {item.title[locale]}
                </a>
              </li>
            ) : (
              <li>
                <span class="sidebar__pending">
                  {item.title[locale]}
                  <span class="visually-hidden"> — {ui.status.plannedNote}</span>
                </span>
              </li>
            ),
          )}
        </ul>
      </div>
    ))
  }
</nav>
