---
/**
 * The sin and cos curves behind the positional encoding, one pair per frequency.
 *
 * The curves are sampled from `positionalEncoding` itself, so the dots sitting
 * on them are the very values the prose quotes.
 */
import type { Locale } from '../../lib/i18n/routing';
import { positionalEncoding, PE_BASE } from '../../lib/math/positional';

interface Props {
  locale: Locale;
  /** How many token positions to mark with a dot */
  tokens?: number;
}
const { locale, tokens = 6 } = Astro.props;
const ko = locale === 'ko';

const D_MODEL = 4;
const SPAN = 24; // positions drawn along the x axis
const { wavelengths } = positionalEncoding(1, D_MODEL);
const pairs = wavelengths.length;

const PAD_L = 196;
const PAD_R = 30;
const W = 700;
const plotW = W - PAD_L - PAD_R;
const rowH = 92;
const yOf = (pair: number) => 52 + pair * rowH;
const xOf = (pos: number) => PAD_L + (pos / SPAN) * plotW;
const vOf = (pair: number, v: number) => yOf(pair) + 30 - v * 26;

/** A smooth curve through many samples; the dots mark the integer positions. */
function curve(pair: number, kind: 'sin' | 'cos'): string {
  const divisor = Math.pow(PE_BASE, (2 * pair) / D_MODEL);
  const pts: string[] = [];
  for (let s = 0; s <= 240; s++) {
    const pos = (s / 240) * SPAN;
    const angle = pos / divisor;
    const v = kind === 'sin' ? Math.sin(angle) : Math.cos(angle);
    pts.push(`${s === 0 ? 'M' : 'L'} ${xOf(pos).toFixed(1)} ${vOf(pair, v).toFixed(1)}`);
  }
  return pts.join(' ');
}

const marked = positionalEncoding(tokens, D_MODEL);

const L = ko
  ? {
      pair: (i: number) => (i === 0 ? '빠른 쪽 (자리 0·1)' : '느린 쪽 (자리 2·3)'),
      wave: (i: number) => `한 바퀴 ${wavelengths[i] < 100 ? wavelengths[i].toFixed(1) : Math.round(wavelengths[i])} 위치`,
      axis: '토큰 위치',
      note: '점이 토큰 자리입니다. 빠른 쪽은 금방 한 바퀴 돌고, 느린 쪽은 거의 움직이지 않습니다.',
      title: '위치 표현을 만드는 sin·cos 곡선',
      desc: `위아래로 두 칸이 있습니다. 위 칸은 빠른 쪽으로, sin 과 cos 이 ${wavelengths[0].toFixed(1)} 위치마다 한 바퀴를 돕니다. 아래 칸은 느린 쪽으로, 한 바퀴가 약 ${Math.round(wavelengths[1])} 위치라서 처음 몇 개 토큰에서는 거의 평평합니다. 각 곡선 위의 점이 토큰 0번부터 ${tokens - 1}번까지의 자리이고, 그 점의 높이가 그대로 위치 벡터의 한 칸이 됩니다.`,
    }
  : {
      pair: (i: number) => (i === 0 ? 'the fast pair (slots 0 and 1)' : 'the slow pair (slots 2 and 3)'),
      wave: (i: number) => `one turn every ${wavelengths[i] < 100 ? wavelengths[i].toFixed(1) : Math.round(wavelengths[i])} positions`,
      axis: 'token position',
      note: 'the dots are token positions. The fast pair turns quickly; the slow one barely moves.',
      title: 'The sin and cos curves behind the positional encoding',
      desc: `Two bands, one above the other. The upper band is the fast pair: its sine and cosine complete a turn every ${wavelengths[0].toFixed(1)} positions. The lower band is the slow pair, which takes about ${Math.round(wavelengths[1])} positions for one turn and is therefore almost flat across the first few tokens. The dots on each curve are token positions 0 to ${tokens - 1}, and the height of a dot is exactly one entry of that token's position vector.`,
    };
---

<svg viewBox={`0 0 ${W} ${52 + pairs * rowH + 34}`} width={W} height={52 + pairs * rowH + 34} role="img" aria-labelledby="pw-t pw-d">
  <title id="pw-t">{L.title}</title>
  <desc id="pw-d">{L.desc}</desc>

  {
    Array.from({ length: pairs }, (_, pair) => (
      <g>
        <text class="tmap__title" x="12" y={yOf(pair) + 4}>
          {L.pair(pair)}
        </text>
        <text class="tmap__note" x="12" y={yOf(pair) + 20}>
          {L.wave(pair)}
        </text>

        {/* the zero line */}
        <path class="tmap__line tmap__line--faint" d={`M ${PAD_L} ${vOf(pair, 0)} H ${W - PAD_R}`} />

        <path class="pw__curve pw__curve--sin" d={curve(pair, 'sin')} />
        <path class="pw__curve pw__curve--cos" d={curve(pair, 'cos')} />

        {marked.terms.map((row) => {
          const sin = row.find((t) => t.pair === pair && t.kind === 'sin')!;
          const cos = row.find((t) => t.pair === pair && t.kind === 'cos')!;
          return (
            <g>
              <circle class="pw__dot pw__dot--sin" cx={xOf(sin.pos)} cy={vOf(pair, sin.value)} r="3.2" />
              <circle class="pw__dot pw__dot--cos" cx={xOf(cos.pos)} cy={vOf(pair, cos.value)} r="3.2" />
            </g>
          );
        })}
      </g>
    ))
  }

  {/* the axis, once, under everything */}
  {
    Array.from({ length: tokens }, (_, pos) => (
      <text class="tmap__note" x={xOf(pos)} y={52 + pairs * rowH + 6} text-anchor="middle">
        {pos}
      </text>
    ))
  }
  <text class="tmap__note" x={PAD_L} y={52 + pairs * rowH + 26}>{L.axis} — {L.note}</text>

  <g>
    <path class="pw__curve pw__curve--sin" d={`M ${W - PAD_R - 120} 24 h 18`} />
    <text class="tmap__note" x={W - PAD_R - 98} y="28">sin</text>
    <path class="pw__curve pw__curve--cos" d={`M ${W - PAD_R - 62} 24 h 18`} />
    <text class="tmap__note" x={W - PAD_R - 40} y="28">cos</text>
  </g>
</svg>
