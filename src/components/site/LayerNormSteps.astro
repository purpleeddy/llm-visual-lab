---
/**
 * Layer normalization done on one real row, drawn as bars so the shift and the
 * squeeze are visible rather than merely stated.
 *
 * The numbers come from `layerNormRow`, the same function the prose quotes.
 */
import type { Locale } from '../../lib/i18n/routing';
import { layerNormRow } from '../../lib/math/blocks';
import { fmt, fmtCompact } from '../../lib/math/format';

interface Props {
  locale: Locale;
  values?: number[];
}
const { locale, values = [2, 8, 4, 6] } = Astro.props;
const ko = locale === 'ko';

const r = layerNormRow(values);
const stages = [r.input, r.centred, r.output];

const BAR_W = 34;
const BAR_GAP = 10;
const PANEL_W = values.length * (BAR_W + BAR_GAP) + 40;
const PANEL_GAP = 58;
const xOf = (s: number) => 30 + s * (PANEL_W + PANEL_GAP);
const yBase = 168;
const SCALE = 11; // pixels per unit
const W = 30 + 3 * PANEL_W + 2 * PANEL_GAP + 20;

const barTop = (v: number) => (v >= 0 ? yBase - v * SCALE : yBase);
const barHeight = (v: number) => Math.abs(v) * SCALE;

const L = ko
  ? {
      stages: [
        '있는 그대로',
        `평균 ${fmtCompact(r.mean)} 만큼 빼기`,
        `${fmt(r.denominator, 3)} 로 나누기`,
      ],
      captions: [
        `평균 ${fmtCompact(r.mean)}, 분산 ${fmtCompact(r.variance)}`,
        '평균이 0 이 됩니다',
        '흩어진 정도가 1 이 됩니다',
      ],
      zero: '0',
      note: '값의 순서와 서로의 관계는 그대로입니다. 자리만 옮기고 폭만 바꿉니다.',
      title: '한 줄을 평균 0, 흩어짐 1 로 맞추기',
      desc: `막대 그림 세 칸입니다. 첫 칸은 원래 값 ${values.join(', ')} 이고 평균은 ${fmtCompact(r.mean)}, 분산은 ${fmtCompact(r.variance)} 입니다. 둘째 칸은 각 값에서 평균을 뺀 것으로, 0 선을 기준으로 위아래로 갈라집니다. 셋째 칸은 그것을 ${fmt(r.denominator, 3)} 로 나눈 결과이고 흩어진 정도가 1 이 됩니다. 세 칸에서 막대의 높낮이 순서는 한 번도 바뀌지 않습니다.`,
    }
  : {
      stages: [
        'as they are',
        `subtract the mean, ${fmtCompact(r.mean)}`,
        `divide by ${fmt(r.denominator, 3)}`,
      ],
      captions: [
        `mean ${fmtCompact(r.mean)}, variance ${fmtCompact(r.variance)}`,
        'the mean becomes 0',
        'the spread becomes 1',
      ],
      zero: '0',
      note: 'the order and the relative sizes survive. Only the position and the width change.',
      title: 'Bringing one row to mean 0 and spread 1',
      desc: `Three panels of bars. The first holds the original values ${values.join(', ')}, whose mean is ${fmtCompact(r.mean)} and variance ${fmtCompact(r.variance)}. The second subtracts the mean from each, so the bars split above and below the zero line. The third divides those by ${fmt(r.denominator, 3)}, which brings the spread to 1. Across all three panels the order of the bars never changes.`,
    };
---

<svg viewBox={`0 0 ${W} 266`} width={W} height="266" role="img" aria-labelledby="lns-t lns-d">
  <title id="lns-t">{L.title}</title>
  <desc id="lns-d">{L.desc}</desc>

  <defs>
    <marker id="lns-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--line-3)"></path>
    </marker>
  </defs>

  {
    stages.map((vals, s) => (
      <g>
        <text class="tmap__title" x={xOf(s)} y="34">
          {L.stages[s]}
        </text>

        {/* the zero line, which only matters once the mean is gone */}
        <path
          class={s === 0 ? 'tmap__line tmap__line--faint' : 'tmap__line'}
          d={`M ${xOf(s)} ${yBase} H ${xOf(s) + PANEL_W - 20}`}
        />
        <text class="tmap__note" x={xOf(s) + PANEL_W - 14} y={yBase + 4}>
          {L.zero}
        </text>

        {vals.map((v, i) => (
          <g>
            <rect
              class={`lns__bar ${v < 0 ? 'lns__bar--neg' : ''}`}
              x={xOf(s) + i * (BAR_W + BAR_GAP)}
              y={barTop(v)}
              width={BAR_W}
              height={Math.max(barHeight(v), 1)}
              rx="2"
            />
            <text
              class="hp__value"
              x={xOf(s) + i * (BAR_W + BAR_GAP) + BAR_W / 2}
              y={v >= 0 ? barTop(v) - 5 : barTop(v) + barHeight(v) + 13}
              text-anchor="middle"
              style="fill: var(--ink-2);"
            >
              {fmt(v, 2)}
            </text>
          </g>
        ))}

        <text class="tmap__note" x={xOf(s)} y="234">
          {L.captions[s]}
        </text>

        {s < 2 ? (
          <path
            class="tmap__line"
            d={`M ${xOf(s) + PANEL_W - 4} ${yBase - 34} H ${xOf(s + 1) - 8}`}
            marker-end="url(#lns-arrow)"
          />
        ) : null}
      </g>
    ))
  }

  <text class="tmap__note" x="30" y="256">{L.note}</text>
</svg>
