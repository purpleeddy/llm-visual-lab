---
/**
 * The "Maximum Path Length" column of Table 1 of the paper, drawn out.
 * In a recurrent layer, information from the first token needs n−1 steps to
 * reach the last one; with self-attention it arrives in a single step.
 */
import type { Locale } from '../../lib/i18n/routing';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ko = locale === 'ko';

const N = 5;
const X0 = 56;
const GAP = 92;
const R = 17;
const xs = Array.from({ length: N }, (_, i) => X0 + i * GAP);
const yTop = 62;
const yBottom = 208;

const L = {
  rnn: ko ? '순환 구조' : 'Recurrent',
  attn: ko ? 'Self-attention' : 'Self-attention',
  rnnNote: ko ? '1번에서 5번까지 4단계' : '4 steps from 1 to 5',
  attnNote: ko ? '1번에서 5번까지 1단계' : '1 step from 1 to 5',
};
---

<svg viewBox="0 0 500 262" width="500" height="262" role="img" aria-labelledby="pld-t pld-d">
  <title id="pld-t">
    {ko ? '순환 구조와 self-attention의 경로 길이 비교' : 'Path length: recurrent versus self-attention'}
  </title>
  <desc id="pld-d">
    {
      ko
        ? '위쪽은 순환 구조입니다. 토큰 다섯 개가 한 줄로 이어져 있고, 화살표가 1번에서 2번, 2번에서 3번으로 차례로만 이어집니다. 1번의 정보가 5번에 닿으려면 네 단계를 거쳐야 합니다. 아래쪽은 self-attention입니다. 1번에서 나머지 네 토큰으로 선이 직접 이어져 있어, 어느 토큰으로든 한 단계에 닿습니다.'
        : 'The top row is a recurrent layer. Five tokens sit in a line and arrows connect only neighbours, 1 to 2, 2 to 3, and so on, so information from token 1 needs four steps to reach token 5. The bottom row is self-attention. Token 1 connects directly to all four others, so it reaches any of them in a single step.'
    }
  </desc>

  <defs>
    <marker id="pld-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink-3)"></path>
    </marker>
    <marker id="pld-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--data-k)"></path>
    </marker>
  </defs>

  <text class="tmap__title" x="12" y="22">{L.rnn}</text>
  <text class="tmap__note" x="12" y="38">{L.rnnNote}</text>

  {
    xs.slice(0, -1).map((x, i) => (
      <path
        class="tmap__line"
        d={`M ${x + R + 3} ${yTop} L ${xs[i + 1] - R - 6} ${yTop}`}
        marker-end="url(#pld-a)"
      />
    ))
  }
  {
    xs.map((x, i) => (
      <g>
        <circle
          cx={x}
          cy={yTop}
          r={R}
          fill={i === 0 ? 'var(--data-q-wash)' : 'var(--surface-raised)'}
          stroke={i === 0 ? 'var(--data-q)' : 'var(--line-3)'}
          stroke-width={i === 0 ? 2 : 1.25}
        />
        <text class="tmap__label" x={x} y={yTop + 4} text-anchor="middle">
          {i + 1}
        </text>
      </g>
    ))
  }

  <text class="tmap__title" x="12" y="150">{L.attn}</text>
  <text class="tmap__note" x="12" y="166">{L.attnNote}</text>

  {/* Every pair, faintly */}
  {
    xs.flatMap((x, i) =>
      xs.slice(i + 1).map((x2) => (
        <path
          d={`M ${x} ${yBottom - R} Q ${(x + x2) / 2} ${yBottom - R - 34} ${x2} ${yBottom - R}`}
          class="tmap__line tmap__line--faint"
        />
      )),
    )
  }
  {/* Only the lines leaving token 1, emphasised */}
  {
    xs.slice(1).map((x2) => (
      <path
        class="tmap__line tmap__line--emph"
        d={`M ${xs[0]} ${yBottom - R} Q ${(xs[0] + x2) / 2} ${yBottom - R - 34} ${x2 - 2} ${yBottom - R - 2}`}
        marker-end="url(#pld-b)"
      />
    ))
  }
  {
    xs.map((x, i) => (
      <g>
        <circle
          cx={x}
          cy={yBottom}
          r={R}
          fill={i === 0 ? 'var(--data-q-wash)' : 'var(--surface-raised)'}
          stroke={i === 0 ? 'var(--data-q)' : 'var(--line-3)'}
          stroke-width={i === 0 ? 2 : 1.25}
        />
        <text class="tmap__label" x={x} y={yBottom + 4} text-anchor="middle">
          {i + 1}
        </text>
      </g>
    ))
  }
</svg>
