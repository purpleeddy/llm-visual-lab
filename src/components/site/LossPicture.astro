---
/**
 * What the loss measures: the model's guess against the target it was given.
 *
 * Three panels — the prediction, a hard target, and the smoothed target — with
 * the loss each one produces. All computed by `crossEntropy`.
 */
import type { Locale } from '../../lib/i18n/routing';
import { crossEntropy, labelSmoothed, oneHot } from '../../lib/math/training';
import { LABEL_SMOOTHING, LOSS_EXAMPLE, LOSS_VOCABULARY } from '../../lib/math/examples';
import { fmt } from '../../lib/math/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ko = locale === 'ko';

const { probabilities, target } = LOSS_EXAMPLE;
const size = probabilities.length;
const hard = oneHot(size, target);
const soft = labelSmoothed(size, target, LABEL_SMOOTHING);
const hardLoss = crossEntropy(probabilities, hard).loss;
const softLoss = crossEntropy(probabilities, soft).loss;

const BAR_W = 40;
const BAR_GAP = 14;
const PANEL_W = size * (BAR_W + BAR_GAP) + 16;
const PANEL_GAP = 56;
const xOf = (p: number) => 34 + p * (PANEL_W + PANEL_GAP);
const yBase = 176;
const SCALE = 108; // a probability of 1 is this tall
const W = 34 + 3 * PANEL_W + 2 * PANEL_GAP + 20;

const panels = [
  { values: probabilities, tone: 'lp__bar--guess' },
  { values: hard, tone: 'lp__bar--target' },
  { values: soft, tone: 'lp__bar--target' },
];

const L = ko
  ? {
      heads: ['모델의 짐작', '정답 (있는 그대로)', `정답 (ε = ${LABEL_SMOOTHING} 로 누그러뜨린 것)`],
      caps: [
        `정답에 ${fmt(probabilities[target], 2)} 를 줬습니다`,
        `틀린 정도 = ${fmt(hardLoss, 4)}`,
        `틀린 정도 = ${fmt(softLoss, 4)}`,
      ],
      note: '누그러뜨리면 틀린 정도가 오히려 커집니다. 논문은 그걸 알고도 씁니다.',
      title: '틀린 정도를 재는 방법',
      desc: `막대 그림 세 칸입니다. 첫 칸은 모델이 네 단어에 매긴 확률로, 정답인 ${LOSS_VOCABULARY[target]} 에 ${fmt(probabilities[target], 2)} 를 줬습니다. 둘째 칸은 정답을 있는 그대로 적은 것으로 정답 자리만 1 이고 나머지는 0 이며, 이때 틀린 정도는 ${fmt(hardLoss, 4)} 입니다. 셋째 칸은 정답의 확신을 ${LABEL_SMOOTHING} 만큼 덜어 나머지에 고르게 나눠 준 것이고, 틀린 정도는 ${fmt(softLoss, 4)} 로 오히려 커집니다.`,
    }
  : {
      heads: ['what the model guessed', 'the answer, as it is', `the answer, softened by ε = ${LABEL_SMOOTHING}`],
      caps: [
        `it gave the right word ${fmt(probabilities[target], 2)}`,
        `loss = ${fmt(hardLoss, 4)}`,
        `loss = ${fmt(softLoss, 4)}`,
      ],
      note: 'softening makes the loss larger. The paper does it knowing that.',
      title: 'How wrong a guess is, as one number',
      desc: `Three panels of bars. The first is the probability the model put on each of four words; the right answer, ${LOSS_VOCABULARY[target]}, got ${fmt(probabilities[target], 2)}. The second is the answer written plainly, 1 on the right word and 0 elsewhere, which gives a loss of ${fmt(hardLoss, 4)}. The third takes ${LABEL_SMOOTHING} of that certainty away and spreads it evenly over the rest, and the loss rises to ${fmt(softLoss, 4)}.`,
    };
---

<svg viewBox={`0 0 ${W} 244`} width={W} height="244" role="img" aria-labelledby="lp-t lp-d">
  <title id="lp-t">{L.title}</title>
  <desc id="lp-d">{L.desc}</desc>

  {
    panels.map((panel, p) => (
      <g>
        <text class="tmap__title" x={xOf(p)} y="30">
          {L.heads[p]}
        </text>
        <path class="tmap__line tmap__line--faint" d={`M ${xOf(p)} ${yBase} H ${xOf(p) + PANEL_W - 16}`} />

        {panel.values.map((v, i) => (
          <g>
            <rect
              class={`lp__bar ${panel.tone} ${i === target ? 'lp__bar--right' : ''}`}
              x={xOf(p) + i * (BAR_W + BAR_GAP)}
              y={yBase - Math.max(v * SCALE, 1)}
              width={BAR_W}
              height={Math.max(v * SCALE, 1)}
              rx="3"
            />
            <text
              class="hp__value"
              x={xOf(p) + i * (BAR_W + BAR_GAP) + BAR_W / 2}
              y={yBase - Math.max(v * SCALE, 1) - 6}
              text-anchor="middle"
              style="fill: var(--ink-2);"
            >
              {fmt(v, 3)}
            </text>
            <text
              class="tmap__note"
              x={xOf(p) + i * (BAR_W + BAR_GAP) + BAR_W / 2}
              y={yBase + 16}
              text-anchor="middle"
            >
              {LOSS_VOCABULARY[i]}
            </text>
          </g>
        ))}

        <text class="tmap__label--sm" x={xOf(p)} y={yBase + 42}>
          {L.caps[p]}
        </text>
      </g>
    ))
  }

  <text class="tmap__note" x="34" y="236">{L.note}</text>
</svg>
