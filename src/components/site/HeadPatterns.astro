---
/**
 * The two heads' attention weights, side by side.
 *
 * These are the **computed** weights of the worked example, not an illustration:
 * the same `computeMultiHead` the prose quotes. If the example changes, so does
 * this figure. The point it makes only lands because the two grids really do
 * differ.
 */
import type { Locale } from '../../lib/i18n/routing';
import { computeMultiHead } from '../../lib/math/multihead';
import { defaultMultiHeadInput } from '../../lib/math/examples';
import { fmt, heatLevel } from '../../lib/math/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ko = locale === 'ko';

const result = computeMultiHead(defaultMultiHeadInput());
const grids = result.perHead.map((r) => r.weights);
const n = result.dims.n;

const CELL = 42;
const PAD = 34;
const GAP = 92;
const gridW = n * CELL;
const xOf = (g: number) => PAD + g * (gridW + GAP);
const yTop = 64;
const W = PAD * 2 + grids.length * gridW + (grids.length - 1) * GAP;

/** Where each head looks hardest, per query row. Read off the computed weights. */
const strongest = grids.map((g) => g.map((row) => row.indexOf(Math.max(...row)) + 1));

const L = ko
  ? {
      head: (i: number) => `갈래 ${i}`,
      rowLabel: (i: number) => `${i}`,
      queryAxis: '보는 쪽',
      keyAxis: '보이는 쪽',
      note: '같은 문장인데 두 갈래가 서로 다른 곳을 봅니다',
      title: '두 갈래의 attention 가중치',
      desc: `${n} × ${n} 짜리 격자 두 개가 나란히 있습니다. 왼쪽이 첫 갈래, 오른쪽이 둘째 갈래이고, 각 칸은 세로축의 토큰이 가로축의 토큰을 얼마나 보는지를 나타내는 확률입니다. 진할수록 큰 값이에요. 첫 갈래에서 1번 토큰이 가장 많이 보는 곳은 ${strongest[0][0]}번이고, 둘째 갈래에서는 ${strongest[1][0]}번입니다. 같은 입력인데 두 격자의 무늬가 서로 다릅니다.`,
    }
  : {
      head: (i: number) => `head ${i}`,
      rowLabel: (i: number) => `${i}`,
      queryAxis: 'looking',
      keyAxis: 'looked at',
      note: 'the same sentence; the two heads look in different places',
      title: 'The attention weights of the two heads',
      desc: `Two ${n} × ${n} grids side by side, head one on the left and head two on the right. Each cell is the probability that the token on the vertical axis assigns to the token on the horizontal axis; darker means larger. In head one, token 1 looks hardest at token ${strongest[0][0]}; in head two it looks hardest at token ${strongest[1][0]}. Same input, different patterns.`,
    };
---

<svg viewBox={`0 0 ${W} 230`} width={W} height="230" role="img" aria-labelledby="hp-t hp-d">
  <title id="hp-t">{L.title}</title>
  <desc id="hp-d">{L.desc}</desc>

  {
    grids.map((grid, g) => (
      <g>
        <text class="tmap__title" x={xOf(g)} y="34">
          {L.head(g + 1)}
        </text>
        <text class="tmap__note" x={xOf(g)} y="50">
          {L.keyAxis} →
        </text>

        {grid.map((row, i) =>
          row.map((v, j) => (
            <g>
              <rect
                class="hp__cell"
                x={xOf(g) + j * CELL}
                y={yTop + i * CELL}
                width={CELL}
                height={CELL}
                style={`fill: var(--seq-${heatLevel(v)});`}
              />
              <text
                class="hp__value"
                x={xOf(g) + j * CELL + CELL / 2}
                y={yTop + i * CELL + CELL / 2 + 4}
                text-anchor="middle"
                style={`fill: var(${heatLevel(v) >= 5 ? '--seq-ink-high' : '--seq-ink-low'});`}
              >
                {fmt(v, 2)}
              </text>
            </g>
          )),
        )}

        {grid.map((_, i) => (
          <text
            class="tmap__note"
            x={xOf(g) - 8}
            y={yTop + i * CELL + CELL / 2 + 4}
            text-anchor="end"
          >
            {L.rowLabel(i + 1)}
          </text>
        ))}
        {grid[0].map((_, j) => (
          <text class="tmap__note" x={xOf(g) + j * CELL + CELL / 2} y={yTop - 6} text-anchor="middle">
            {L.rowLabel(j + 1)}
          </text>
        ))}
      </g>
    ))
  }

  <text class="tmap__note" x={PAD} y={yTop + n * CELL + 26}>{L.note}</text>
</svg>
