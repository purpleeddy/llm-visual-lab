---
/**
 * Where a unit continues: its editable experiments in the lab and its background in
 * the paper companion. Replaces the folded drawers the main article used to carry.
 */
import { docSectionById } from '../../lib/nav';
import { docHref, type Locale } from '../../lib/i18n/routing';

interface Props {
  locale: Locale;
  /** Section id on the lab page */
  lab?: string;
  /** Section id on the paper page */
  paper?: string;
}

const { locale, lab, paper } = Astro.props;
const ko = locale === 'ko';
const links = [
  lab ? { doc: 'lab', id: lab, label: ko ? '실험실' : 'Lab' } : null,
  paper ? { doc: 'paper', id: paper, label: ko ? '논문 읽기' : 'The paper' } : null,
].filter((link) => link !== null).map((link) => {
  const section = docSectionById(link.doc, link.id);
  if (!section) throw new Error(`no ${link.doc} section: ${link.id}`);
  return { ...link, title: section.title[locale], href: `${docHref(locale, link.doc)}#${link.id}` };
});
---
<ul class="lesson-more" aria-label={ko ? '이어서 볼 곳' : 'Continue elsewhere'}>
  {links.map((link) => <li><a href={link.href} data-more={link.doc}><span>{link.label}</span>{link.title}</a></li>)}
</ul>
