---
/**
 * The picture that opens the attention chapter: the final position gathers content from
 * the positions it may read, each in proportion to its share. Every number comes from
 * the article's shared snapshot (first head, final position), so the figure and the
 * calculations below it cannot drift apart.
 */
import type { Locale } from '../../lib/i18n/routing';
import { lessonSnapshot } from '../../lib/math/lessonGeneration';
import { LEARNING_EXAMPLE } from '../../lib/math/examples';
import { fmtCompact, fmtPercent } from '../../lib/math/format';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ko = locale === 'ko';
const run = lessonSnapshot();
const row = run.lastPosition;
const head = run.attention.perHead[0];
const tokens = run.tokenIds.map(id => LEARNING_EXAMPLE[locale].tokens[id]);
const shares = head.weights[row].slice(0, tokens.length);
const output = head.output[row];
const n = tokens.length;
const y = (i: number) => (i + 0.5) / n * 240;
const path = (i: number) => Math.abs(y(i) - 120) < 1e-9 ? 'M 0 120 H 196' : `M 0 ${y(i)} H 110 C 150 ${y(i)} 152 120 196 120`;
const numbers = (values: number[]) => `(${values.map(value => fmtCompact(value)).join(', ')})`;
---
<figure class="attention-overview attention-flow" data-attention-flow>
  <div class="attention-overview__scroll" role="region" tabindex="0" aria-label={ko ? '각 자리의 내용이 마지막 자리로 모이는 그림' : 'Content from each position flowing into the final position'}>
    <div class="attention-overview__canvas">
      <div class="attention-overview__headings"><span>{ko ? '입력' : 'Input'}</span><span>{ko ? '새 값' : 'New values'}</span></div>
      <div class="attention-overview__diagram">
        <div class="attention-overview__sources" style={`grid-template-rows: repeat(${n}, 1fr);`}>
          {tokens.map((token, i) => <div class="attention-overview__source"><span data-flow-token={i}>{token}</span></div>)}
        </div>
        <div class="attention-overview__links">
          <svg viewBox="0 0 200 240" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <defs><marker id="attention-flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="var(--data-k)"></path></marker></defs>
            {shares.map((share, i) => <path data-flow-edge={i} d={path(i)} fill="none" stroke="var(--data-k)" stroke-width={1.5 + 8 * share} vector-effect="non-scaling-stroke" marker-end="url(#attention-flow-arrow)" />)}
          </svg>
          {shares.map((share, i) => <span class="attention-overview__weight" style={`top: ${(i + 0.5) / n * 100}%;`}>
            <span class="visually-hidden">{ko ? `${tokens[i]}에서 가져오는 몫: ` : `Share taken from ${tokens[i]}: `}</span><span data-flow-share={i}>{fmtPercent(share, 1)}</span>
          </span>)}
        </div>
        <div class="attention-overview__output" data-flow-output>
          <strong>{tokens[row]}</strong>
          <span data-flow-output-values>{numbers(output)}</span>
        </div>
      </div>
    </div>
  </div>
  <figcaption>{ko ? '선의 굵기가 가져오는 몫이고, 두 몫을 더하면 100%입니다.' : 'Line width shows each share; the shares add up to 100%.'}</figcaption>
</figure>
