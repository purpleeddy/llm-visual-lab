---
/** The preceding product Y, with each row kept intact as a column of Yᵀ. */
import type { Locale } from '../../lib/i18n/routing';
import { DEFAULT_X, DEFAULT_WQ } from '../../lib/math/examples';
import { matmul, transpose } from '../../lib/math/matrix';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const ko = locale === 'ko';
const Y = matmul(DEFAULT_X, DEFAULT_WQ);
const YT = transpose(Y);
const CELL = 36;
const xL = 28;
const xR = 222;
const yTop = 62;
const rowFill = ['var(--data-q-wash)', 'var(--data-k-wash)', 'var(--data-v-wash)'];
const rowStroke = ['var(--data-q)', 'var(--data-k)', 'var(--data-v)'];
const title = ko ? '전치 — Y의 행을 Yᵀ의 열에 놓기' : 'Transpose — rows of Y become columns of Yᵀ';
const desc = ko
  ? `앞의 곱셈으로 만든 3행 2열 Y를 전치하면 2행 3열 Yᵀ가 됩니다. Y의 각 행 ${Y.map(row => '(' + row.join(', ') + ')').join(', ')}을 순서와 값 그대로 Yᵀ의 각 열에 놓습니다.`
  : `The preceding product Y has 3 rows and 2 columns; Yᵀ has 2 rows and 3 columns. Each row of Y, ${Y.map(row => '(' + row.join(', ') + ')').join(', ')}, becomes a column of Yᵀ with its values and order unchanged.`;
---
<svg viewBox="0 0 360 218" width="360" height="218" role="img" aria-labelledby="tf-t tf-d">
  <title id="tf-t">{title}</title>
  <desc id="tf-d">{desc}</desc>
  <defs><marker id="tf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="var(--line-3)"></path></marker></defs>
  <text class="tmap__head" x={xL + CELL} y="27" text-anchor="middle">Y</text>
  <text class="tmap__note" x={xL + CELL} y="46" text-anchor="middle">3 × 2</text>
  {Y.map((row, i) => row.map((value, j) => <g>
    <rect x={xL+j*CELL} y={yTop+i*CELL} width={CELL} height={CELL} fill={rowFill[i]} stroke={rowStroke[i]} />
    <text class="hp__value" x={xL+j*CELL+CELL/2} y={yTop+i*CELL+CELL/2+5} text-anchor="middle" style="fill: var(--ink-1); font-size: 16px;">{value}</text>
  </g>))}
  <path class="tmap__line" d={`M ${xL+2*CELL+20} 108 H ${xR-20}`} marker-end="url(#tf-arrow)"></path>
  <text class="tmap__op" x="162" y="94" text-anchor="middle">ᵀ</text>
  <text class="tmap__head" x={xR+CELL*1.5} y="27" text-anchor="middle">Yᵀ</text>
  <text class="tmap__note" x={xR+CELL*1.5} y="46" text-anchor="middle">2 × 3</text>
  {YT.map((row, i) => row.map((value, j) => <g>
    <rect x={xR+j*CELL} y={yTop+i*CELL} width={CELL} height={CELL} fill={rowFill[j]} stroke={rowStroke[j]} />
    <text class="hp__value" x={xR+j*CELL+CELL/2} y={yTop+i*CELL+CELL/2+5} text-anchor="middle" style="fill: var(--ink-1); font-size: 16px;">{value}</text>
  </g>))}
  <text class="tmap__note" x="180" y="205" text-anchor="middle">{ko ? '같은 색: 같은 숫자 줄' : 'Same colour: the same list of numbers'}</text>
</svg>
