---
/**
 * Why taking the best word at each step is not the same as the best sentence.
 *
 * The tree is the toy model in `examples.ts`, and the two paths are whatever
 * `greedy` and `beamSearch` actually return — not drawn by hand. If the toy
 * model changes, the picture follows.
 */
import type { Locale } from '../../lib/i18n/routing';
import { beamSearch, greedy, END } from '../../lib/math/generation';
import { TOY_MODEL } from '../../lib/math/examples';
import { fmt } from '../../lib/math/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ko = locale === 'ko';

const g = greedy(TOY_MODEL);
const b = beamSearch(TOY_MODEL, 2);
const greedyPath = g.best.tokens;
const beamPath = b.best.tokens;

/** The first two levels of the tree; deeper than that the picture stops helping. */
const level1 = Object.entries(TOY_MODEL['']);
const level2 = level1.map(([tok]) => ({ parent: tok, children: Object.entries(TOY_MODEL[tok] ?? {}) }));

const ROOT_X = 46;
const L1_X = 190;
const L2_X = 400;
const NODE_W = 40;
const NODE_H = 28;
const yMid = 150;
const l1Y = (i: number) => 52 + i * 96;
const l2Y = (p: number, i: number, total: number) => l1Y(p) - ((total - 1) * 26) / 2 + i * 26;
const W = 700;

const onGreedy = (path: string[]) => path.every((t, i) => greedyPath[i] === t);
const onBeam = (path: string[]) => path.every((t, i) => beamPath[i] === t);

const L = ko
  ? {
      start: '시작',
      greedy: `매번 최선: ${greedyPath.join(' ')} = ${fmt(g.best.probability, 3)}`,
      beam: `두 개를 들고 가기: ${beamPath.join(' ')} = ${fmt(b.best.probability, 3)}`,
      note: '첫 걸음에서 더 좋아 보이던 쪽이 끝까지 가면 집니다.',
      title: '한 걸음의 최선과 문장 전체의 최선',
      desc: `왼쪽에서 시작해 오른쪽으로 갈라지는 나무입니다. 첫 걸음의 후보는 ${level1.map(([t, p]) => `${t} ${p}`).join(', ')} 입니다. 매번 가장 큰 것만 고르면 ${greedyPath.join(' ')} 로 가고 전체 확률은 ${fmt(g.best.probability, 3)} 입니다. 후보를 두 개씩 들고 가면 ${beamPath.join(' ')} 를 찾아내고 전체 확률은 ${fmt(b.best.probability, 3)} 입니다. 첫 걸음에서는 ${greedyPath[0]} 가 ${beamPath[0]} 보다 컸는데도 그렇습니다.`,
    }
  : {
      start: 'start',
      greedy: `best each time: ${greedyPath.join(' ')} = ${fmt(g.best.probability, 3)}`,
      beam: `keeping two: ${beamPath.join(' ')} = ${fmt(b.best.probability, 3)}`,
      note: 'the branch that looked better at the first step loses over the whole sentence.',
      title: 'The best step against the best sentence',
      desc: `A tree branching left to right. The first step offers ${level1.map(([t, p]) => `${t} at ${p}`).join(', ')}. Taking the largest every time leads to ${greedyPath.join(' ')}, whose probability over the whole sentence is ${fmt(g.best.probability, 3)}. Carrying two candidates finds ${beamPath.join(' ')} instead, at ${fmt(b.best.probability, 3)} — even though ${greedyPath[0]} was the larger of the two at the first step.`,
    };
---

<svg viewBox={`0 0 ${W} 344`} width={W} height="344" role="img" aria-labelledby="bt-t bt-d">
  <title id="bt-t">{L.title}</title>
  <desc id="bt-d">{L.desc}</desc>

  <rect class="tmap__box tmap__box--embed" x={ROOT_X} y={yMid - NODE_H / 2} width={56} height={NODE_H} rx="4"></rect>
  <text class="tmap__note" x={ROOT_X + 28} y={yMid + 5} text-anchor="middle">{L.start}</text>

  {
    level1.map(([tok, p], i) => (
      <g>
        <path
          class={`bt__edge ${onGreedy([tok]) ? 'bt__edge--greedy' : ''} ${onBeam([tok]) ? 'bt__edge--beam' : ''}`}
          d={`M ${ROOT_X + 58} ${yMid} C ${ROOT_X + 110} ${yMid}, ${L1_X - 50} ${l1Y(i) + NODE_H / 2}, ${L1_X - 2} ${l1Y(i) + NODE_H / 2}`}
        />
        <text class="tmap__note" x={(ROOT_X + 58 + L1_X) / 2} y={(yMid + l1Y(i) + NODE_H / 2) / 2 - 6} text-anchor="middle">
          {p}
        </text>
        <rect class="tmap__box tmap__box--head" x={L1_X} y={l1Y(i)} width={NODE_W} height={NODE_H} rx="4" />
        <text class="tmap__head" x={L1_X + NODE_W / 2} y={l1Y(i) + 19} text-anchor="middle">
          {tok}
        </text>

        {level2[i].children.map(([tok2, p2], j) => (
          <g>
            <path
              class={`bt__edge ${onGreedy([tok, tok2]) ? 'bt__edge--greedy' : ''} ${onBeam([tok, tok2]) ? 'bt__edge--beam' : ''}`}
              d={`M ${L1_X + NODE_W + 2} ${l1Y(i) + NODE_H / 2} C ${L1_X + 90} ${l1Y(i) + NODE_H / 2}, ${L2_X - 60} ${l2Y(i, j, level2[i].children.length) + 10}, ${L2_X - 2} ${l2Y(i, j, level2[i].children.length) + 10}`}
            />
            <rect
              class={`tmap__box ${tok2 === END ? 'tmap__box--norm' : ''}`}
              x={L2_X}
              y={l2Y(i, j, level2[i].children.length)}
              width={NODE_W}
              height={20}
              rx="3"
            />
            <text class="hp__value" x={L2_X + NODE_W / 2} y={l2Y(i, j, level2[i].children.length) + 14} text-anchor="middle" style="fill: var(--ink-1);">
              {tok2}
            </text>
            <text class="tmap__note" x={L2_X + NODE_W + 8} y={l2Y(i, j, level2[i].children.length) + 14}>
              {p2}
            </text>
          </g>
        ))}
      </g>
    ))
  }

  <g>
    <path class="bt__edge bt__edge--greedy" d={`M ${L2_X + 130} 44 h 22`} />
    <text class="tmap__note" x={L2_X + 158} y="48">{L.greedy}</text>
    <path class="bt__edge bt__edge--beam" d={`M ${L2_X + 130} 66 h 22`} />
    <text class="tmap__note" x={L2_X + 158} y="70">{L.beam}</text>
  </g>

  <text class="tmap__note" x={ROOT_X} y="334">{L.note}</text>
</svg>
