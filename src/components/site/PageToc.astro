---
/**
 * The contents rail on the right — the sections of the article being read.
 *
 * The twelve sections come from `nav.ts`, so the server renders them directly.
 * Only the sub-headings (h3) **inside** a section are folded in by script,
 * under whichever section is being read. Section headings (h2) are rendered by
 * the Section component, so they never reach Astro's `headings` array; the
 * sub-headings arrive flat, with nothing to say where one section ends.
 *
 * Without JavaScript this stays a twelve-line list, which navigates fine.
 */
import { SECTIONS } from '../../lib/nav';
import { type Locale } from '../../lib/i18n/routing';
import { t } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
---

<nav class="toc" id="doc-nav" aria-label={ui.nav.onThisPage}>
  <p class="toc__title">{ui.nav.contents}</p>
  <ol class="toc__list" data-section-nav>
    {
      SECTIONS.map((s, i) =>
        s.status === 'planned' ? (
          <li>
            <span class="toc__pending" data-note={s.stage}>
              <span class="toc__num">{i + 1}</span>
              {s.title[locale]}
              <span class="visually-hidden"> — {ui.status.plannedNote}</span>
            </span>
          </li>
        ) : (
          <li data-section-item={s.id}>
            <a class="toc__link" href={`#${s.id}`} data-section-link={s.id}>
              <span class="toc__num">{i + 1}</span>
              {s.title[locale]}
            </a>
          </li>
        ),
      )
    }
  </ol>
</nav>
