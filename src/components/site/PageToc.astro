---
/** Four coarse stages; open the current stage, then request its detailed headings. */
import { LESSON_DOCS, DOC_SECTIONS } from '../../lib/nav';
import { type Locale } from '../../lib/i18n/routing';
import { t } from '../../lib/i18n/ui';
interface Props { locale: Locale; docId?: string; }
const { locale, docId = '' } = Astro.props;
const ui = t(locale);
/** The article and the walkthrough group their units into stages; the lab and paper pages list sections flat. */
const lesson = LESSON_DOCS[docId];
const flat = lesson ? null : DOC_SECTIONS[docId] ?? [];
const GROUPS = lesson?.groups ?? [];
const SECTIONS = lesson?.sections ?? [];
const first = flat ? flat[0] : SECTIONS[0];
const total = flat ? flat.length : SECTIONS.length;
---
<nav class="toc" id="doc-nav" aria-label={ui.nav.onThisPage}>
  <p class="toc__title">{ui.nav.contents}</p>
  {first ? <p class="toc__current" aria-live="polite"><span>{locale === 'ko' ? '현재 위치' : 'Current unit'}</span><strong data-current-lesson>1/{total} · {first.navTitle[locale]}</strong></p> : null}
  {flat ? (
    <ol class="toc__list toc__stage-list" data-section-nav>
      {flat.map((s, i) => <li data-section-item={s.id}>
        <a class="toc__link" href={`#${s.id}`} data-section-link={s.id} data-short-title={s.navTitle[locale]}>
          <span class="toc__num">{i + 1}</span>{s.navTitle[locale]}
        </a>
      </li>)}
    </ol>
  ) : (
  <ol class="toc__list" data-section-nav>
    {GROUPS.map((group, gi) => <li class="toc__group">
      <details class="toc__stage" data-toc-stage={group.id} open={gi === 0}>
        <summary><span class="toc__group-title">{group.title[locale]}</span><span class="toc__count">{SECTIONS.filter(s => s.group === group.id).length} {locale === 'ko' ? '단원' : 'units'}</span></summary>
        <ol class="toc__stage-list">
          {SECTIONS.filter(s => s.group === group.id).map(s => <li data-section-item={s.id}>
            <a class="toc__link" href={`#${s.id}`} data-section-link={s.id} data-short-title={s.navTitle[locale]}>
              <span class="toc__num">{SECTIONS.findIndex(x => x.id === s.id) + 1}</span>{s.navTitle[locale]}
            </a>
          </li>)}
        </ol>
      </details>
    </li>)}
  </ol>
  )}
</nav>
